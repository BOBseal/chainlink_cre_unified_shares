# Example environment variables for forge deployment.
# Copy this file to .env and fill in your own values.

# Trusted forwarder address used by the CSE contracts.
TRUSTED_FORWARD=0x0000000000000000000000000000000000000000

# Private key used for deployment. Set this in your local .env only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional custom metadata for CSE721 and CSE1155 deployments.
CSE721_NAME=CSE721 Share Token
CSE721_SYMBOL=CSE721
CSE1155_URI=https://example.com/metadata/{id}.json

# Optional RPC URL for the target network.
RPC_URL=https://rpc.your-network.example
